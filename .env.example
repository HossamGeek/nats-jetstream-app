# HTTP port for the NestJS application
PORT=3000

# NATS connection settings
# Comma-separated list of NATS server URLs. A single URL also works, e.g.
# NATS_SERVERS=nats://nats-a:4222,nats://nats-b:4222
NATS_SERVERS=nats://localhost:4222
NATS_CONNECTION_NAME=nats-jetstream-app
NATS_CONNECT_TIMEOUT=5000
# Set to "true" to crash the app when NATS is unreachable at startup
NATS_FAIL_ON_STARTUP=false
